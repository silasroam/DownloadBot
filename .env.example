# Telegram API credentials -> https://my.telegram.org/apps
API_ID=12345678
API_HASH=your_api_hash_here
BOT_TOKEN=your_bot_token_here

# Pyrogram session file name (without extension)
SESSION_NAME=downloader_bot

# Hard file size cap, in megabytes (Telegram allows up to 2000 MB)
MAX_FILE_SIZE_MB=2000

# Temporary storage for finished downloads (wiped after every upload)
DOWNLOAD_DIR=downloads/

# --- Web service / Render.com -------------------------------------------------
# Port for the built-in health server. Render injects PORT automatically
# (10000), the default below is what Render uses for Docker web services.
PORT=10000

# Address the health server binds to (0.0.0.0 is required inside containers)
# HOST=0.0.0.0

# Provided automatically by Render; when present the bot pings its own
# /health endpoint so a free instance is not spun down after ~15 min idle.
# RENDER_EXTERNAL_URL=https://your-service-name.onrender.com

# Self-ping cadence in minutes (clamped to 1..14; 13 keeps the service awake)
# SELF_PING_INTERVAL_MINUTES=13

# Optional overrides
# FFMPEG_PATH=/usr/bin/ffmpeg
# Explicit cookies file; when unset it is auto-detected at
# /etc/secrets/cookies.txt (Render Secret Files) or ./cookies.txt
# COOKIES_FILE=/path/to/cookies.txt
# WORKERS=4
# MAX_CONCURRENT_TRANSMISSIONS=4
